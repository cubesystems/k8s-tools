#!/usr/bin/env bash
# Journals contain encrypted originals/replacements and key references, never key values.
check_rekey_paths() {
  local index target
  [ -f "$recovery_dir/ready" ] && [ -f "$recovery_dir/files.tsv" ] || die 'Not a complete rekey recovery directory'
  while IFS=$'\t' read -r index target; do
    case "$index" in ''|*[!0-9]*) die 'Invalid rekey journal entry';; esac
    case "$target" in /*) ;; *) die 'Rekey journal paths must be absolute';; esac
    [ -f "$recovery_dir/$index.old" ] && [ -f "$recovery_dir/$index.new" ] || die 'Incomplete rekey journal'
    [ -f "$target" ] && [ ! -L "$target" ] || die "Recovery target is missing or is now a symlink: $target"
    if ! cmp -s "$target" "$recovery_dir/$index.old" && ! cmp -s "$target" "$recovery_dir/$index.new"; then
      die "File changed since rekey; refusing to overwrite it: $target"
    fi
  done < "$recovery_dir/files.tsv"
}

recover_rekey() {
  [ -d "$recovery_dir" ] || die "Recovery directory not found: $recovery_dir"
  recovery_dir=$(realpath "$recovery_dir")
  check_rekey_paths
  local index target replacement
  while IFS=$'\t' read -r index target; do
    if cmp -s "$target" "$recovery_dir/$index.old"; then continue; fi
    cmp -s "$target" "$recovery_dir/$index.new" || die "File changed during recovery: $target"
    temporary_file replacement "$(dirname "$target")/.k8s-tools.XXXXXX"
    cp -p "$recovery_dir/$index.old" "$replacement"
    mv -f "$replacement" "$target"
  done < "$recovery_dir/files.tsv"
  echo 'Restored the previous encrypted files and key references. CI key variables may also need restoring.' >&2
}

rekey_deployments() {
  local selected_json original_config config_json updated_config name values_file old_json decrypted encrypted updated
  local index existing_index shared_name shared_file key_loaded replacement target
  local rotation_paths=() rotation_refs=()
  selected_json=$(printf '%s\n' "${rotation_names[@]}" | jq -Rs 'split("\n") | map(select(length > 0)) | unique')
  original_config=$deployments_file
  config_json=$config
  resolve_encryption_key "$new_key_ref"
  local rekey_new_key=$deployment_encryption_key rekey_old_key
  unset deployment_encryption_key
  recovery_dir=$(mktemp -d "$runtime_dir/.secrets-rekey.XXXXXX")
  chmod 700 "$recovery_dir"
  cp -p "$original_config" "$recovery_dir/config.original"
  [ "$(read_yaml_json "$recovery_dir/config.original" | jq -Sc .)" = "$(printf '%s' "$config_json" | jq -Sc .)" ] || die 'Configuration changed while preparing rekey; nothing saved'
  : > "$recovery_dir/files.tsv"
  index=0

  for name in "${rotation_names[@]}"; do
    deployment_name=$name
    source "$tools_dir/load_deployment_config"
    [ "$deployment_key_ref" != "$new_key_ref" ] || die "New keyRef must differ from the current reference for $name"
    load_values_files
    key_loaded=false
    for values_file in "${values_files[@]}"; do
      case "$values_file" in *$'\n'*|*$'\t'*) die 'Rekey filenames cannot contain tabs or newlines';; esac
      existing_index=0
      for target in "${rotation_paths[@]}"; do
        if [ "$target" = "$values_file" ]; then
          [ "${rotation_refs[$existing_index]}" = "$deployment_key_ref" ] || die "Shared file uses different key references: $values_file"
          break
        fi
        existing_index=$((existing_index + 1))
      done
      if [ "$existing_index" -lt "${#rotation_paths[@]}" ]; then continue; fi
      old_json=$(read_yaml_json "$values_file")
      if [ "$(printf '%s' "$old_json" | jq '[.secrets[]?.data[]? | select(. != null)] | length')" -eq 0 ]; then continue; fi
      printf '%s' "$old_json" | validate_secret_values
      if [ "$key_loaded" = false ]; then
        load_encryption_key
        rekey_old_key=$deployment_encryption_key
        unset deployment_encryption_key
        [ "$rekey_old_key" != "$rekey_new_key" ] || die "New encryption key equals the existing key for $name"
        key_loaded=true
      fi
      cp -p "$values_file" "$recovery_dir/$index.old"
      old_json=$(read_yaml_json "$recovery_dir/$index.old")
      decrypted=$(transform_secrets decrypt "$old_json" "$rekey_old_key")
      encrypted=$(transform_secrets encrypt-all "$decrypted" "$rekey_new_key")
      # Verify the new ciphertext reproduces exactly the plaintext we transformed.
      [ "$(transform_secrets decrypt "$encrypted" "$rekey_new_key" | jq -Sc .)" = "$(printf '%s' "$decrypted" | jq -Sc .)" ] || die 'Rekey verification failed'
      updated=$(printf '%s\n%s\n' "$old_json" "$encrypted" | jq -sc '.[0] + .[1]')
      prepare_yaml_update "$recovery_dir/$index.old" "$updated" "$recovery_dir/$index.new"
      rotation_paths+=("$values_file")
      rotation_refs+=("$deployment_key_ref")
      printf '%s\t%s\n' "$index" "$values_file" >> "$recovery_dir/files.tsv"
      index=$((index + 1))
    done
  done
  unset rekey_new_key rekey_old_key decrypted

  # A shared file must never be rotated behind another deployment's back.
  local unselected
  unselected=$(printf '%s' "$config_json" | jq -r --argjson selected "$selected_json" '.deployments | keys - $selected | .[]')
  while IFS= read -r shared_name; do
    [ -n "$shared_name" ] || continue
    deployment_name=$shared_name
    source "$tools_dir/load_deployment_config"
    load_values_files
    for shared_file in "${values_files[@]}"; do
      for target in "${rotation_paths[@]}"; do
        [ "$shared_file" != "$target" ] || die "Also include deployment '$shared_name' in rekey: it shares $shared_file. No source files changed."
      done
    done
  done <<< "$unselected"

  cp -p "$recovery_dir/config.original" "$recovery_dir/$index.old"
  updated_config=$(printf '%s' "$config_json" | jq --argjson selected "$selected_json" --arg ref "$new_key_ref" \
    'reduce $selected[] as $name (.; .deployments[$name].keyRef = $ref)')
  prepare_yaml_update "$recovery_dir/$index.old" "$updated_config" "$recovery_dir/$index.new"
  printf '%s\t%s\n' "$index" "$original_config" >> "$recovery_dir/files.tsv"
  : > "$recovery_dir/ready"
  check_rekey_paths
  printf 'Encrypted recovery copies: %s\n' "$recovery_dir" >&2
  while IFS=$'\t' read -r index target; do
    cmp -s "$target" "$recovery_dir/$index.old" || die "File changed while preparing rekey: $target. Recover with: secrets recover '$recovery_dir'"
    temporary_file replacement "$(dirname "$target")/.k8s-tools.XXXXXX"
    cp -p "$recovery_dir/$index.new" "$replacement"
    if ! mv -f "$replacement" "$target"; then
      die "Rekey interrupted. Restore with: secrets recover '$recovery_dir'"
    fi
  done < "$recovery_dir/files.tsv"
  echo 'Rekey complete. Update DEPLOY_ENCRYPTION_KEY in CI when adopting these files; keep the old key until the migration is complete.' >&2
}
