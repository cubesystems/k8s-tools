#!/usr/bin/env bash

if [ "$#" -lt 2 ]; then
  echo "Usage: $0 ENVIRONMENT IMAGE_TAG" >&2
  exit 1
fi

# exit on any failing command
set -e

environment_name=$1
image_tag=$2
app_version="${image_tag}-`date -u +%s`"
extra_args=${@:3}

if [ -n "$DEPLOY_RESOURCE_PREFIX" ]; then
  resource_prefix=${DEPLOY_RESOURCE_PREFIX}-
else
  resource_prefix=""
fi

# common call
require_encryption_key=1
source $(dirname $(realpath ${0}))/load_environment_config

environment_values=`echo "$config" | jq -r ".environments[\"${environment_name}\"].values | map(\"${runtime_dir}/values/\" + .) | join(\",\")"`

helm_key_args=()

if [ -n "${environment_encryption_key}" ]; then
  # keep the key out of argv, where any same-user process would see it via ps
  # fixed fd number rather than `exec {fd}<` - macOS ships bash 3.2, which has no auto-allocation
  # single quotes keep any passphrase a YAML string; '' is the escape for a literal quote
  escaped_encryption_key=$(printf '%s' "${environment_encryption_key}" | sed "s/'/''/g")
  exec 9< <(printf "encryptionKey: '%s'\n" "${escaped_encryption_key}")
  helm_key_args=(--values /dev/fd/9)
fi

helm upgrade \
  ${release} \
  ${chart_arg} \
  -n ${environment_namespace} \
  --install \
  --values "${environment_values}" \
  "${helm_key_args[@]}" \
  --set image.tag=${image_tag} \
  --set appVersion=${app_version} \
  --set resourcePrefix=${resource_prefix} \
  ${extra_args}

if [ "$extra_args"  == '' ] || [ -n "$DEPLOY_TRACK" ]; then
  ${tools_dir}/track_helm_deployment ${release} ${environment_namespace}
fi
