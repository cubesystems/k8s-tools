#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/common"
parse_common_options "$@"
set -- "${command_args[@]}"
usage_help='Options: --no-wait --timeout 5m --restart'
require_usage 1 'DEPLOYMENT [IMAGE_TAG | --image-tag TAG] [HELM_OPTIONS]' "$@"
source "$tools_dir/prepare_deployment"
if [ "${preview_mode:-false}" = true ]; then
  source "$tools_dir/render_preview"
  exit 0
fi
source "$tools_dir/secret_functions"
prepare_secret_overlay
print_target
# Helm's stderr is shown as it comes and kept, so known failures can get a hint below.
temporary_file helm_errors
deploy_status=0
{ helm upgrade "$release" "${chart_args[@]}" "${helm_connection_args[@]}" \
    --install --reset-values "${namespace_args[@]}" --timeout "$deployment_timeout" \
    "${deployment_values_args[@]}" "${extra_args[@]}" 2>&1 1>&3 | tee "$helm_errors" >&2; } 3>&1 || deploy_status=$?
if [ "$deploy_status" -ne 0 ]; then
  if grep -q 'another operation (install/upgrade/rollback) is in progress' "$helm_errors"; then
    printf 'A previous upgrade was interrupted and Helm still marks it pending. Check %s, then roll back to the\nlast deployed revision with %s and deploy again.\n' \
      "./k8s-tools/history $deployment_name" "./k8s-tools/rollback $deployment_name REVISION" >&2
  elif grep -q 'Unauthorized' "$helm_errors"; then
    printf 'Kubernetes rejected the credentials. With an OIDC kubeconfig, run %s to renew the login, then deploy again.\n' \
      "./kubectl $deployment_name auth whoami" >&2
  fi
  exit "$deploy_status"
fi
if [ "$wait_enabled" = true ]; then
  source "$tools_dir/track_deployment"
  track_release_rollout "$deployment_timeout_seconds"
fi
