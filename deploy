#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/common"
parse_common_options "$@"
set -- "${command_args[@]}"
usage_help='Options: --no-wait --timeout 5m --rollback-on-failure --restart'
require_usage 1 'DEPLOYMENT [IMAGE_TAG | --image-tag TAG] [HELM_OPTIONS]' "$@"
source "$tools_dir/prepare_deployment"
if [ "${preview_mode:-false}" = true ]; then
  source "$tools_dir/render_preview"
  exit 0
fi
source "$tools_dir/secret_functions"
prepare_secret_overlay
print_target
deploy_status=0
helm upgrade "$release" "${chart_args[@]}" "${helm_connection_args[@]}" \
  --install --reset-values "${namespace_args[@]}" "${wait_args[@]}" --timeout "$deployment_timeout" \
  "${deployment_values_args[@]}" "${extra_args[@]}" || deploy_status=$?
if [ "$deploy_status" -ne 0 ]; then
  printf 'Deployment failed (exit %s). Release workloads, pods and warning events:\n' "$deploy_status" >&2
  # Charts rarely label pods with the release instance, so list all pods in the namespace.
  release_workloads >&2 2>/dev/null || echo 'Could not fetch release workloads' >&2
  kubectl "${kube_args[@]}" get pods --request-timeout=10s >&2 ||
    echo 'Could not fetch pod diagnostics' >&2
  kubectl "${kube_args[@]}" get events --field-selector type=Warning --sort-by=.lastTimestamp --request-timeout=10s >&2 ||
    echo 'Could not fetch warning events' >&2
  exit "$deploy_status"
fi
