#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/common"
parse_common_options "$@"
set -- "${command_args[@]}"
require_usage 2 'DEPLOYMENT POD_NAME [COMMAND ARG...]' "$@"
deployment_name=$1
pod_name=$2
shift 2
if [ "$#" -eq 0 ]; then set -- sh; fi
require_cluster=1
source "$tools_dir/load_deployment_config"
pods=$(kubectl "${kube_args[@]}" get pods -o json)
matching_pods=$(printf '%s' "$pods" | jq -r --arg name "$pod_name" '
  [.items[] | select(.status.phase == "Running") | .metadata.name] |
  if index($name) then [$name] else map(select(contains($name))) end | .[]')
[ -n "$matching_pods" ] || die "No running pod matching \"$pod_name\" found"
if [ "$(printf '%s\n' "$matching_pods" | wc -l | tr -d ' ')" -ne 1 ]; then
  printf 'Several pods match; specify an exact name:\n%s\n' "$matching_pods" >&2
  exit 1
fi
exec_in_pod "$matching_pods" -- "$@"
