#!/usr/bin/env bash
validate_secret_values() {
  jq -e '
    if (.secrets | type) != "object" then error("secrets must be a mapping") else
    .secrets | to_entries | all(.[];
      .key as $name | .value |
      if . == null then true
      elif type != "object" then error("secrets." + $name + " must be a mapping or null")
      elif .data == null then true
      elif (.data | type) != "object" then error("secrets." + $name + ".data must be a mapping or null") else
      .data | to_entries | all(.[];
        if .value == null or (.value | type) == "string" then true else error("secrets." + $name + ".data." + .key + " must be a string or null; quote numbers and booleans") end)
      end) end' >/dev/null
}

prepare_yaml_update() {
  local input_file=$1 target_json=$2 output_file=$3 old_json expression actual_json
  old_json=$(read_yaml_json "$input_file")
  expression=$(printf '%s\n%s\n' "$old_json" "$target_json" | jq -rsf "$tools_dir/yaml_changes.jq")
  cp -p "$input_file" "$output_file"
  if [ -n "$expression" ]; then yq "$expression" "$input_file" > "$output_file"; fi
  actual_json=$(read_yaml_json "$output_file" | jq -Sc .)
  [ "$actual_json" = "$(printf '%s' "$target_json" | jq -Sc .)" ] || die 'YAML update did not produce the expected document'
}

save_secret_file() {
  local target_json=$1 staged_file
  temporary_file staged_file "$(dirname "$values_path")/.k8s-tools.XXXXXX"
  prepare_yaml_update "$original_file" "$target_json" "$staged_file"
  cmp -s "$values_path" "$original_file" || die "File changed while editing; nothing saved: $values_path"
  if cmp -s "$staged_file" "$original_file"; then echo 'No changes' >&2; return; fi
  # Only the finished encrypted replacement inherits the source file's mode.
  chmod "$original_mode" "$staged_file"
  mv -f "$staged_file" "$values_path"
  printf 'Updated %s\n' "$values_path" >&2
}

read_secret_file() {
  [ -f "$values_path" ] || die "Values file not found: $values_path"
  values_path=$(realpath "$values_path")
  # GNU/BusyBox and BSD stat use different flags for the octal permission mode.
  if original_mode=$(stat -c %a "$values_path" 2>/dev/null); then :;
  else original_mode=$(stat -f %Lp "$values_path"); fi
  temporary_file original_file
  # Do not copy permissions: the snapshot can contain plaintext and must stay 600.
  cp "$values_path" "$original_file"
  original_json=$(read_yaml_json "$original_file")
  secret_json=$(printf '%s' "$original_json" | jq -c '{secrets:(.secrets // {})}')
  printf '%s' "$secret_json" | validate_secret_values
}
