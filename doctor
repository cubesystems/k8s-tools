#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/common"
parse_common_options "$@"
set -- "${command_args[@]}"
require_usage 0 '[--cluster] [DEPLOYMENT]' "$@"
doctor_status=0
for dependency in bash realpath helm kubectl yq jq; do
  if command -v "$dependency" >/dev/null; then printf '%s: %s\n' "$dependency" "$(command -v "$dependency")";
  else printf '%s: missing\n' "$dependency" >&2; doctor_status=1; fi
done
[ "$doctor_status" = 0 ] || die 'Install the missing utilities; see README Setup'
yq --version | grep -Eq 'mikefarah/yq.*version v4\.' || die 'Install Mike Farah yq v4; other programs named yq are incompatible'
helm_version=$(helm version --short)
case "$helm_version" in
  v3.*) helm_minor=${helm_version#v3.}; helm_minor=${helm_minor%%.*}; [ "$helm_minor" -ge 14 ] || die 'Helm >= 3.14 is required';;
  v4.*) ;;
  *) die "Unsupported Helm version: $helm_version";;
esac
jq -n 'walk(.)' >/dev/null
printf 'Helm: %s | Bash: %s | yq and jq: compatible\n' "$helm_version" "$BASH_VERSION"
if [ "${1:-}" = --cluster ]; then require_cluster=1; shift; fi
if [ "$#" -gt 0 ]; then
  deployment_name=$1
  source "$tools_dir/load_deployment_config"
  load_values_files
  if [ -n "$deployment_key_ref" ] && [ -z "${DEPLOY_ENCRYPTION_KEY:-}" ]; then
    case "$deployment_key_ref" in
      axo://*) need_command ap; echo 'Axo Pass CLI found (key not unlocked)';;
      file://*) key_path=$(absolute_path "${deployment_key_ref#file://}"); [ -r "$key_path" ] || die "Key file is not readable: $key_path";;
    esac
  fi
  if [ -n "${require_cluster:-}" ]; then print_target; kubectl "${kube_args[@]}" auth can-i get pods; fi
  printf '%s: local configuration checked\n' "$deployment_name"
elif [ -n "${require_cluster:-}" ]; then die '--cluster requires a deployment name'; fi
