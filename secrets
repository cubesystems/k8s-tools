#!/usr/bin/env bash
source "$(dirname "$(realpath "$0")")/common"
parse_common_options "$@"
set -- "${command_args[@]}"
usage_help="Actions: encrypt|decrypt DEPLOYMENT [FILE] [--in-place]
         set DEPLOYMENT [FILE] --secret NAME --key KEY [--stdin]
         edit DEPLOYMENT [FILE]
         rekey DEPLOYMENT [DEPLOYMENT...] --to-key-ref REF
         recover DIRECTORY"
require_usage 2 'ACTION DEPLOYMENT [FILE] [OPTIONS]' "$@"
action=$1
shift
if [ "$action" = recover ]; then
  [ "$#" -eq 1 ] || die 'Usage: secrets recover DIRECTORY'
  recovery_dir=$1
  source "$tools_dir/rekey_secrets"
  recover_rekey
  exit 0
fi
deployment_name=$1
rotation_names=("$deployment_name")
shift
case "$action" in encrypt|decrypt|set|edit|rekey) ;; *) die "Unknown secrets action: $action";; esac
values_path=
secret_name=
secret_key=
read_stdin=false
in_place=false
new_key_ref=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --file|--secret|--key|--to-key-ref)
      [ "$#" -ge 2 ] || die "$1 requires a value"
      case "$1" in
        --file) values_path=$2;;
        --secret) secret_name=$2;;
        --key) secret_key=$2;;
        --to-key-ref) new_key_ref=$2;;
      esac
      shift 2;;
    --stdin) read_stdin=true; shift;;
    --in-place) in_place=true; shift;;
    -* ) die "Unknown secrets option: $1";;
    *)
      if [ "$action" = rekey ]; then rotation_names+=("$1");
      elif [ -z "$values_path" ]; then values_path=$1;
      else die "Unexpected argument: $1"; fi
      shift;;
  esac
done
if [ "$action" = set ]; then
  [ -n "$secret_name" ] && [ -n "$secret_key" ] || die '--secret NAME and --key KEY are required'
fi
source "$tools_dir/load_deployment_config"
need_command helm
source "$tools_dir/secret_functions"
source "$tools_dir/edit_secret_file"
if [ "$action" = rekey ]; then
  [ -n "$new_key_ref" ] || die '--to-key-ref is required'
  source "$tools_dir/rekey_secrets"
  rekey_deployments
  exit 0
fi
if [ -z "$values_path" ]; then
  # Without FILE (or --file FILE), the deployment's only values file is used.
  load_values_files
  case "${#values_files[@]}" in
    0) die "No values files are configured for $deployment_name; pass FILE";;
    1) values_path=${values_files[0]}; printf 'Using %s\n' "$values_path" >&2;;
    *)
      printf 'Several values files are configured for %s. Specify one:\n' "$deployment_name" >&2
      printf '%s\n' "${values_files[@]}" >&2
      exit 1;;
  esac
fi
if [ "$in_place" = true ] && [ "$action" != encrypt ]; then die '--in-place is supported only for encrypt'; fi
if [ "$read_stdin" = true ] && [ "$action" != set ]; then die '--stdin is supported only for set'; fi
read_secret_file
load_encryption_key

case "$action" in
  encrypt|decrypt)
    transformed=$(transform_secrets "$action" "$secret_json" "$deployment_encryption_key")
    if [ "$in_place" = true ]; then
      updated_json=$(printf '%s\n%s\n' "$original_json" "$transformed" | jq -sc '.[0] + .[1]')
      save_secret_file "$updated_json"
    else printf '%s' "$transformed" | yq -P -p=json '.'; fi;;
  set)
    [ -n "$secret_name" ] && [ -n "$secret_key" ] || die '--secret NAME and --key KEY are required'
    if [ "$read_stdin" = true ]; then
      new_values=$(jq -Rs --arg name "$secret_name" --arg key "$secret_key" '{secrets:{($name):{data:{($key):.}}}}')
    else
      [ -t 0 ] || die 'Use --stdin when setting a secret noninteractively'
      printf 'New value: ' >&2
      IFS= read -r -s new_value
      printf '\n' >&2
      new_values=$(printf '%s' "$new_value" | jq -Rs --arg name "$secret_name" --arg key "$secret_key" '{secrets:{($name):{data:{($key):.}}}}')
      unset new_value
    fi
    transformed=$(transform_secrets encrypt-all "$new_values" "$deployment_encryption_key")
    updated_json=$(printf '%s\n%s\n' "$original_json" "$transformed" | jq -sc '.[0] * .[1]')
    save_secret_file "$updated_json";;
  edit)
    plaintext=$(transform_secrets decrypt "$secret_json" "$deployment_encryption_key")
    editor_dir=$(mktemp -d "${TMPDIR:-/tmp}/k8s-tools-editor.XXXXXX")
    chmod 700 "$editor_dir"
    temporary_dirs+=("$editor_dir")
    editor_file=$editor_dir/secrets.yaml
    temporary_files+=("$editor_file")
    (umask 077; printf '%s' "$plaintext" | yq -P -p=json '.' > "$editor_file")
    editor_command=${VISUAL:-${EDITOR:-vi}}
    if [ -x "$editor_command" ]; then editor_args=("$editor_command");
    else read -r -a editor_args <<< "$editor_command"; fi
    "${editor_args[@]}" "$editor_file"
    edited_json=$(read_yaml_json "$editor_file")
    printf '%s' "$edited_json" | jq -e 'keys == ["secrets"]' >/dev/null ||
      die 'The editor document may contain only the secrets mapping'
    printf '%s' "$edited_json" | validate_secret_values
    if [ "$(printf '%s' "$plaintext" | jq -Sc .)" = "$(printf '%s' "$edited_json" | jq -Sc .)" ]; then
      echo 'No changes' >&2
      exit 0
    fi
    transformed=$(transform_secrets encrypt-all "$edited_json" "$deployment_encryption_key")
    # Preserve ciphertext for unchanged values, including when neighboring keys are added/deleted.
    stable=$(printf '%s\n%s\n%s\n%s\n' "$secret_json" "$plaintext" "$edited_json" "$transformed" | jq -sc '
      .[0] as $original | .[1] as $before | .[2] as $after | .[3] |
      .secrets |= with_entries(.key as $set |
        .value |= (if . == null or .data == null then . else
        .data |= with_entries(.key as $key |
          if ($before.secrets[$set].data | type) == "object" and
             ($before.secrets[$set].data | has($key)) and
             $before.secrets[$set].data[$key] == $after.secrets[$set].data[$key]
          then .value = $original.secrets[$set].data[$key] else . end) end))')
    updated_json=$(printf '%s\n%s\n' "$original_json" "$stable" | jq -sc '.[0] + .[1]')
    save_secret_file "$updated_json";;
esac
