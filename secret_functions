#!/usr/bin/env bash
# Never trace key material, plaintext editor content, or decrypted values.
set +x

transform_secrets() (
  local transform_action=$1 transform_input=$2 transform_key=$3
  exec 8< <(printf '%s\n' "$transform_input")
  exec 9< <(printf '%s' "$transform_key" | jq -Rs '{__k8s_tools: {encryptionKey: .}}')
  helm template local-secrets "$tools_dir/secrets-chart" \
    --values /dev/fd/8 --values /dev/fd/9 --set-string "__k8s_tools.action=$transform_action" |
    yq -o=json -I=0 '.' | jq -ec .
)

prepare_secret_overlay() {
  deployment_values_args=("${values_args[@]}" "${application_args[@]}" "${override_args[@]}")
  decrypted_values='{"secrets":{}}'
  [ -n "$deployment_key_ref" ] || [ "${DEPLOY_ENCRYPTION_KEY+x}" = x ] || return 0
  local encrypted_values
  encrypted_values=$(helm template local-secrets "$tools_dir/secrets-chart" \
    "${deployment_values_args[@]}" --set-string __k8s_tools.action=inspect |
    yq -o=json -I=0 '.' | jq -ec .)
  if [ "$(printf '%s' "$encrypted_values" | jq '[.secrets[]?.data[]? | select(. != null)] | length')" -eq 0 ]; then return 0; fi
  load_encryption_key
  decrypted_values=$(transform_secrets decrypt "$encrypted_values" "$deployment_encryption_key")
  unset deployment_encryption_key
  local merged_values
  merged_values=$(printf '%s\n%s\n' "$encrypted_values" "$decrypted_values" | jq -sc '.[0] + .[1]')
  exec 8< <(printf '%s\n' "$merged_values")
  deployment_values_args=(--values /dev/fd/8)
}

redact_manifests() (
  local managed_values=${decrypted_values:-}
  if [ -z "$managed_values" ]; then managed_values='{}'; fi
  exec 9< <(printf '%s\n' "$managed_values")
  jq -s --slurpfile managed /dev/fd/9 '
    . as $documents |
    ([($managed[0].secrets // {})[]?.data[]? | select(type == "string" and length > 0)] +
     [.. | objects | select(.kind? == "Secret") | (.stringData // {})[] | select(type == "string" and length > 0)] +
     [.. | objects | select(.kind? == "Secret") | (.data // {})[] | select(type == "string" and length > 0) | @base64d]) |
    unique | sort_by(length) | reverse as $plain |
    ($plain + [$plain[] | @base64]) as $sensitive |
    $documents[] | walk(
      if type == "object" and .kind? == "Secret" then
        (if has("data") and .data != null then .data |= with_entries(.value = "<redacted>") else . end) |
        (if has("stringData") and .stringData != null then .stringData |= with_entries(.value = "<redacted>") else . end)
      elif type == "string" then
        reduce $sensitive[] as $secret (.; if $secret == "" then . else split($secret) | join("<redacted>") end)
      else . end)' | yq -P -p=json '.'
)
